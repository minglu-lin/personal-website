# ==============================================================================
# Cloudflare Custom Domain Email - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values. NEVER commit .env to git!

# Cloudflare Global Credentials (Required)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# Domain Configuration
DOMAIN_NAME=yourdomain.com
MAIL_SUBDOMAIN=mail.yourdomain.com

# Passwords & Security
SITE_PASSWORD=your_optional_site_passcode
ADMIN_PASSWORD=your_secure_admin_password_here
ALERT_EMAIL=security_alerts@yourdomain.com

# Outbound External Email Gateway (Optional - Resend API Key for sending to any external address)
RESEND_TOKEN=re_your_resend_api_key_here

# Target Server IP for A Record (If hosting frontend on VPS/Nginx)
SERVER_IP=192.0.2.1
