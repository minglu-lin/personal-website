[Unit]
Description=Fleet Status Monitor Telemetry Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fleet-probe-agent
Environment=PROBE_NODE_ID=node-us-west
Environment=PROBE_SERVER_URL=https://status.yourdomain.com/api/report
Environment=PROBE_TOKEN=your_secure_probe_token_here
Environment=PROBE_INTERVAL=3
ExecStart=/usr/bin/python3 /opt/fleet-probe-agent/probe_agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
